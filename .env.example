# =============================================================================
#  Marketing Data Portal — settings
#
#  Platform credentials do NOT go here. Accounts are added from the browser,
#  on the Connections screen, and stored in the local database. This file is
#  only for how the portal itself behaves.
# =============================================================================

# ---- server -----------------------------------------------------------------
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8787
# For production OAuth, use the exact registered HTTPS callback.
# PORTAL_OAUTH_REDIRECT_URI=https://portal.example.com/oauth/callback
# Keep Secure enabled for localhost and all HTTPS use. Set false only for
# isolated HTTP-only local development, never for access from other devices.
PORTAL_COOKIE_SECURE=true
# Only trust forwarded client-IP headers from these local reverse proxies.
# Forwarded IPs are ignored unless this lists a trusted proxy that overwrites
# client-supplied forwarding headers. Leave blank for direct localhost use.
PORTAL_TRUSTED_PROXY_IPS=

# Optional remote MCP access for ChatGPT and other hosted AI clients.
# HTTP MCP stays disabled when this is blank. Use a long random value and keep
# it private. Claude Desktop's local process connection does not need a token.
PORTAL_MCP_TOKEN=

# Leave these unset on this Mac. The local portal uses macOS Keychain. The
# server deployment uses PORTAL_SECRET_STORE=fernet plus a 32-byte Fernet key.
# PORTAL_SECRET_STORE=keychain
# PORTAL_SECRET_ENCRYPTION_KEY=

# Optional local AI model served by Ollama on 127.0.0.1:11434. The portal
# uses basic report answers when this model is not installed or running.
PORTAL_LOCAL_AI_MODEL=qwen3:1.7b

# Shown in the UI. Scheduled syncs run on this machine's own clock.
PORTAL_TIMEZONE=Asia/Kolkata
PORTAL_CURRENCY=INR

# Where the SQLite warehouse lives. The default on macOS is
#   ~/Library/Application Support/marketing-portal/portal.db
# rather than the project folder, because iCloud-synced folders (Documents and
# Desktop often are) cannot host a SQLite database. Uncomment to move it — any
# always-local path works.
# PORTAL_DB_PATH=~/Library/Application Support/marketing-portal/portal.db

# ---- sample data ------------------------------------------------------------
# Seeds 90 days of generic sample data so the dashboard works before anything
# is connected. Set to false once your own data is flowing, then run:
#   python3 -m portal.cli reset-demo
DEMO_MODE=true

# ---- refreshing -------------------------------------------------------------
# How many days back each scheduled sync re-pulls. Ad platforms restate
# conversions for days afterwards, so a rolling window beats "yesterday only".
SYNC_LOOKBACK_DAYS=30
SCHEDULER_ENABLED=true
# Hour of the day (this machine's local time) for the full daily sync.
SYNC_HOUR_LOCAL=6
SYNC_TOPUP_HOURS=4

# ---- your funnel ------------------------------------------------------------
# Every business runs a different funnel, so its order and wording are settings.
# Pick from: leads, contacted, qualified, booked, completed, won — in the order
# your pipeline actually runs. Stages that are empty for a given lead type are
# hidden automatically, so one order can serve several funnels.
#
# Example, for a business that qualifies inbound leads before anyone calls:
#   FUNNEL_ORDER=leads,qualified,contacted,booked,completed,won
#   FUNNEL_LABELS=Leads,Qualified,Contacted,Inspection planned,Inspection done,Procured
FUNNEL_ORDER=leads,contacted,qualified,booked,completed,won
FUNNEL_LABELS=Leads,Contacted,Qualified,Booked,Completed,Won
