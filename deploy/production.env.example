# Copy this file to deploy/production.env on the server. Never commit it.
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8787
# Supabase PostgreSQL (use the pooler/direct URL with sslmode=require). Never commit.
PORTAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
PORTAL_DB_PATH=/data/portal.db
PORTAL_SECRET_STORE=fernet
# Generate once with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_SECRET_ENCRYPTION_KEY=
# Generate and back up a separate Fernet key for portal MFA seeds.
PORTAL_MFA_ENCRYPTION_KEY=
PORTAL_COOKIE_SECURE=true
PORTAL_TRUSTED_PROXY_IPS=127.0.0.1
# Keep this false for reverse-proxy and public deployments.
PORTAL_TRUST_LOOPBACK_HOST_FOR_SETUP=false
PORTAL_OAUTH_REDIRECT_URI=https://portal.example.com/oauth/callback
PORTAL_TIMEZONE=Asia/Kolkata
PORTAL_CURRENCY=INR
DEMO_MODE=false
SCHEDULER_ENABLED=true
SYNC_LOOKBACK_DAYS=30
SYNC_HOUR_LOCAL=6
SYNC_TOPUP_HOURS=4
PORTAL_MCP_TOKEN=
OPENAI_API_KEY=
PORTAL_OPENAI_MODEL=gpt-6-luna
