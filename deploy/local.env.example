# Copy this file to deploy/local.env before running the local Docker container.
# Never commit deploy/local.env.
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8787
PORTAL_DB_PATH=/data/portal.db
PORTAL_SECRET_STORE=fernet
# Generate once with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_SECRET_ENCRYPTION_KEY=
PORTAL_COOKIE_SECURE=true
PORTAL_TRUSTED_PROXY_IPS=
# Required only because Docker Desktop presents the host as a bridge address.
# The local Compose file binds the portal to 127.0.0.1, and proxy headers are
# still rejected during first-admin setup.
PORTAL_TRUST_LOOPBACK_HOST_FOR_SETUP=true
PORTAL_TIMEZONE=Asia/Kolkata
PORTAL_CURRENCY=INR
DEMO_MODE=false
SCHEDULER_ENABLED=true
SYNC_LOOKBACK_DAYS=30
SYNC_HOUR_LOCAL=6
SYNC_TOPUP_HOURS=4
PORTAL_MCP_TOKEN=
OPENAI_API_KEY=
PORTAL_OPENAI_MODEL=gpt-6-luna
